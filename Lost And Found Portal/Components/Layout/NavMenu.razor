@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav

<header class="navbar navbar-expand-md navbar-dark bg-navy-custom px-4 shadow-sm">
    <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between">

        <a class="navbar-brand d-flex align-items-center fw-bold text-white fs-4" href="" style="letter-spacing: 1px;">
            <i class="bi bi-shield-check text-info me-2"></i>
            AU KHARIAN <span class="text-info ms-1 fw-light">PORTAL</span>
        </a>

        <div class="d-flex flex-wrap align-items-center justify-content-center flex-grow-1 my-2 my-md-0 gap-2 gap-md-3">
            <NavLink class="nav-link text-white-50 px-2 small fw-semibold" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door me-1"></i> Home
            </NavLink>

            <NavLink class="nav-link text-white-50 px-2 small fw-semibold" href="browse-items">
                <i class="bi bi-grid-fill me-1"></i> Browse Items
            </NavLink>

            @if (SessionState.IsLoggedIn)
            {
                <NavLink class="nav-link text-white-50 px-2 small fw-semibold" href="report-case">
                    <i class="bi bi-plus-circle-fill me-1"></i> Report Case
                </NavLink>

                <NavLink class="nav-link text-white-50 px-2 small fw-semibold" href="dashboard">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </NavLink>

                @if (IsUserAdmin())
                {
                    <NavLink class="nav-link text-warning px-2 small fw-bold" href="admin/analytics">
                        <i class="bi bi-graph-up me-1"></i> Analytics
                    </NavLink>
                    <NavLink class="nav-link text-warning px-2 small fw-bold" href="admin/moderation">
                        <i class="bi bi-shield-lock-fill me-1"></i> Moderation
                    </NavLink>
                }
            }
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (SessionState.IsLoggedIn)
            {
                <span class="text-white-50 small d-none d-lg-inline">
                    Active: <strong class="text-info font-monospace">@SessionState.CurrentUserEmail</strong>
                </span>
                <button class="btn btn-info-pill fw-bold text-dark px-3 py-1.5 btn-sm shadow-sm" @onclick="LogUserOut">
                    <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                </button>
            }
            else
            {
                <a href="login" class="btn btn-info-pill fw-bold text-dark px-4 py-2 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                </a>
            }
        </div>

    </div>
</header>

@code {
    private bool IsUserAdmin()
    {
        if (string.IsNullOrEmpty(SessionState.CurrentUserEmail)) return false;

        return SessionState.CurrentUserEmail.Contains("admin") ||
               SessionState.CurrentUserEmail.StartsWith("247240"); // Admin evaluation bypass rule for your email
    }

    private void LogUserOut()
    {
        // 🚀 FIX: Call the updated centralized session cleaner
        SessionState.ClearSession();
        Nav.NavigateTo("/");
    }
}