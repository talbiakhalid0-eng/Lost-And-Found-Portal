@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-light sticky-top px-4 py-3 custom-navbar-shadow">
    <div class="container-fluid">


        <a class="navbar-brand d-flex align-items-center gap-2 gap-sm-3 fw-bold tracking-wide" href="">
            <div class="logo-airplane-wrapper d-flex align-items-center justify-content-center" title="Air University Systems">
                <i class="bi bi-airplane-engines fs-5 text-info rotate-logo"></i>
            </div>

            <span class="navbar-title-text">
                <span class="text-info">Air </span>University Lost And Found
            </span>
        </a>

        <div class="d-flex align-items-center ms-auto gap-4">

            <a class="nav-link-custom" href="#how-it-works">How Portal Works</a>
            <a class="nav-link-custom small" href="browse-items">Browse Items</a>

            @if (SessionState.IsLoggedIn)
            {
                <span class="text-white-50 small d-none d-md-inline">@SessionState.CurrentUserEmail</span>
                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" @onclick="LogUserOut">
                    SIGN OUT
                </button>
            }
            else
            {
                <a href="login" class="btn btn-sm btn-info text-dark rounded-pill px-4 fw-bold text-uppercase shadow-sm">
                    Sign In
                </a>
            }

        </div>
    </div>
</nav>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 🚀 THE CRITICAL FIX: Load from browser storage *after* rendering to handle the full page reload safely
            await SessionState.LoadSessionFromBrowserAsync();

            // Subscribe to our unified state alteration notifier loop
            SessionState.OnChange += HandleStateHasChanged;

            // Force a layout tree refresh now that credentials have been retrieved
            StateHasChanged();
        }
    }

    private void HandleStateHasChanged()
    {
        // Safely force cross-thread interactive rendering updates inside your active SignalR hub
        InvokeAsync(StateHasChanged);
    }

    private async Task LogUserOut()
    {
        // Clean out your browser storage tokens asynchronously
        await SessionState.ClearSession();

        // Push the user back out onto the landing route
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        // Securely unhook event tracking links to eliminate memory leak overhead risks
        SessionState.OnChange -= HandleStateHasChanged;
    }
}