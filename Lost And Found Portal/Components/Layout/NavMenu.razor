@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm py-3">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-white d-flex align-items-center" href="">
            <i class="bi bi-shield-check text-info me-2 fs-4"></i>
            AU KHARIAN <span class="text-info ms-1 fw-light">PORTAL</span>
        </a>

        <div class="d-flex align-items-center ms-auto gap-3">
            <a class="nav-link text-white-50 small fw-semibold px-2" href="/#how-it-works">How Portal Works</a>
            <a class="nav-link text-white-50 small fw-semibold px-2" href="browse-items">Browse Items</a>

            @if (SessionState.IsLoggedIn)
            {
                <a class="nav-link text-white-50 small fw-semibold px-2" href="report-case">Report Case</a>
                <a class="nav-link text-white-50 small fw-semibold px-2" href="dashboard">Dashboard</a>

                <span class="text-info small font-monospace d-none d-md-inline ms-2">
                    @SessionState.CurrentUserEmail
                </span>
                <button class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold" @onclick="LogUserOut">
                    Sign Out
                </button>
            }
            else
            {
                <a href="login" class="btn btn-sm btn-info text-dark rounded-pill px-3 fw-bold">
                    Sign In
                </a>
            }
        </div>
    </div>
</nav>

@code {
    private void LogUserOut()
    {
        SessionState.ClearSession();
        Nav.NavigateTo("/");
    }
}