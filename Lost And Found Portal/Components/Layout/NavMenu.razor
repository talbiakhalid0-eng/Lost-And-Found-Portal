@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top px-4 py-3 custom-navbar-shadow">
    <div class="container-fluid">

        <a class="navbar-brand fw-bold text-white tracking-wide" href="">
            <span class="text-info">Air </span> University Lost And Found
        </a>

        <div class="d-flex align-items-center ms-auto gap-4">

            <a class="nav-link-custom text-white-50 " href="#how-it-works">How Portal Works</a>
            <a class="nav-link-custom text-white-50 small " href="browse-items">Browse Items </a>

            @if (SessionState.IsLoggedIn)
            {
                <button class="btn btn-sm btn-outline-info rounded-pill px-3" @onclick="LogUserOut">
                    SIGN OUT
                </button>
            }
            else
            {
                <a href="login" class="btn btn-sm btn-info text-dark rounded-pill px-4 fw-bold text-uppercase shadow-sm">
                    Sign In
                </a>
            }

            <div class="logo-airplane-wrapper ms-2 d-flex align-items-center justify-content-center" title="Air University Systems">
                <i class="bi bi-airplane-engines fs-4 text-info rotate-logo"></i>
            </div>

        </div>
    </div>
</nav>

@code {
    private void LogUserOut()
    {
        SessionState.ClearSession();
        Nav.NavigateTo("/");
    }
}