@inherits LayoutComponentBase
@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (SessionState.IsLoggedIn)
            {
                <span class="me-3 text-secondary">Logged in as: <strong>@SessionState.CurrentUserEmail</strong></span>
                <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="SessionState.Logout">Sign Out</button>
            }
            else
            {
                <a href="login" class="btn btn-sm btn-info rounded-pill px-3">Sign In</a>
            }
        </div>

        <article class="content px-4">
            @* CRITICAL FIX: This tells Blazor exactly where to inject your pages! *@
            @Body
        </article>
    </main>
</div>