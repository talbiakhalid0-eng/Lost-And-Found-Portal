@inherits LayoutComponentBase

<div class="page" style="background-color: #0d1117; color: #c9d1d9; min-height: 100vh; display: flex;">
    <div class="sidebar" style="width: 250px; background: #161b22; border-right: 1px solid #30363d;">
        <NavMenu />
    </div>

    <main style="flex-grow: 1; overflow-y: auto;">
        <div class="top-row px-4" style="background: #161b22; border-bottom: 1px solid #30363d; height: 3.5rem; display: flex; align-items: center;">
            <span class="text-info fw-bold">Admin Dashboard</span>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
