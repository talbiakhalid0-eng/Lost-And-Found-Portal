@inherits LayoutComponentBase

<div class="page">
    @* Feature #11: Collapsible Sidebar Container *@
    <div class="sidebar shadow-lg">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 border-bottom bg-dark">
            <span class="text-info small fw-bold">CERTO SECURITY PORTAL v1.0</span>
        </div>

        <article class="content px-4 py-3">
            @* This is where your Index.razor content is injected *@
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>