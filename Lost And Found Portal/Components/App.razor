<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        /* Custom Corporate Navy Palette for AU Portal Headers */
        .bg-navy-custom {
            background-color: #0a192f !important;
        }

        /* HERO LAYOUT GRAPHIC GENERATION SYSTEM */
        .hero-viewport {
            min-height: 85vh;
            background: url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?q=80&w=1200') no-repeat center center;
            background-size: cover;
            isolation: isolate;
        }

        .hero-overlay-blur {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(10, 25, 47, 0.9), rgba(17, 34, 64, 0.75));
            z-index: -1;
        }

        /* TRANSLUCENT GLASS CARD OVERLAY SPECIFICATION */
        .glass-card {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(12px) saturate(160%) !important;
            -webkit-backdrop-filter: blur(12px) saturate(160%) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            max-width: 750px;
        }

        /* DECORATION PILL RULES */
        .btn-info-pill {
            background-color: #0dcaf0 !important;
            color: #0a192f !important;
            border-radius: 50px;
            transition: all 0.2s ease;
        }

            .btn-info-pill:hover {
                background-color: #0baccc !important;
                transform: translateY(-2px);
            }

        /* UTILITIES */
        .bg-light-danger {
            background-color: #fee2e2;
        }

        .bg-light-info {
            background-color: #e0f2fe;
        }

        .bg-light-success {
            background-color: #dcfce7;
        }

        .work-step-icon {
            width: 70px;
            height: 70px;
        }

        .fw-black {
            font-weight: 900;
        }

        .text-shadow-sm {
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        /* ENTRANCE FADE ANIMATION */
        .animate-fade-in {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <HeadOutlet />
</head>

<body>
    @* FIX: Using the proper RenderMode syntax context *@
    <Routes @rendermode="RenderMode.InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
</body>

</html>