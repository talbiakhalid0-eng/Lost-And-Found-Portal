@page "/"
@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="hero-isolated-container">
    <div class="transparent-glass-card p-4 p-md-5 rounded-4 text-center mx-3">
        <span class="badge bg-info text-dark mb-3 fw-bold px-3 py-2 text-uppercase shadow-sm" style="letter-spacing: 1px;">
            AU Kharian Campus Gateway
        </span>
        <h1 class="fw-bold text-white mb-3 text-uppercase tracking-wide"
            style="font-family: 'Montserrat', sans-serif; font-size: 3.5rem; text-shadow: 0px 4px 12px rgba(0,0,0,0.65);">
            Lost And Found <span style="color: #00d4ff;">Portal</span>
        </h1>
        <p class="text-white fw-medium fs-5 mb-4 custom-text-shadow" style="line-height: 1.6; opacity: 0.95;">
            Welcome to the official automated portal for tracking, reporting, and reclaiming misplaced assets within the university premises.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="report-case" class="btn btn-info px-4 py-2.5 fw-bold rounded-pill text-dark shadow-sm nav-link-custom">
                <i class="bi bi-plus-circle me-2"></i>Report Case
            </a>
        </div>
    </div>
</div>

<div id="how-it-works" class="glass-section-panel">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-white display-6" style="font-weight: 600;">How The Portal Works</h2>
            <p class="text-info fw-semibold text-uppercase small" style="letter-spacing: 1.5px;">
                Simple 3-step asset retrieval lifecycle management
            </p>
        </div>

        <div class="row g-5 text-center">
            <div class="col-md-4">
                <div class="icon-badge text-info shadow-sm">
                    <i class="bi bi-pencil-square fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2" style="font-weight: 600;">1. Submit a Case</h5>
                <p class="text-white-50 small px-3" style="line-height: 1.6;">
                    Log missing properties or report items discovered on university grounds instantly.
                </p>
            </div>
            <div class="col-md-4">
                <div class="icon-badge text-info shadow-sm">
                    <i class="bi bi-shield-check fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2" style="font-weight: 600;">2. Search & Match</h5>
                <p class="text-white-50 small px-3" style="line-height: 1.6;">
                    Browse indexed registries globally via live structural attribute filtering models.
                </p>
            </div>
            <div class="col-md-4">
                <div class="icon-badge text-info shadow-sm">
                    <i class="bi bi-hand-thumbs-up fs-3"></i>
                </div>
                <h5 class="fw-bold text-white mb-2" style="font-weight: 600;">3. Reclaim Property</h5>
                <p class="text-white-50 small px-3" style="line-height: 1.6;">
                    Verify item ownership context securely at the campus safety desk for checkout sign-off.
                </p>
            </div>
        </div>
    </div>
</div>

<footer class="solid-navy-footer text-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="text-info fw-bold mb-3" style="font-weight: 700; letter-spacing: 0.5px;">
                    <i class="bi bi-building me-2"></i>Air University Kharian Campus
                </h5>
                <p class="small text-white-50 mb-3" style="line-height: 1.6; max-width: 480px;">
                    Official recovery portal designed to support administrative custody and student safety operations across corporate university sectors.
                </p>
                <p class="small text-white-50 m-0">
                    <i class="bi bi-geo-alt-fill text-info me-2"></i>GT Road, Kharian, Punjab, Pakistan
                </p>
            </div>
            <div class="col-md-6 text-md-end">
                <h5 class="text-info fw-bold mb-3" style="font-weight: 700; letter-spacing: 0.5px;">
                    <i class="bi bi-telephone-fill me-2"></i>Security Desk Help
                </h5>
                <p class="small text-white-50 mb-1"><strong>Support Line:</strong> +92-53-111-282-111</p>
                <p class="small text-white-50 mb-1"><strong>Administrative Email:</strong> support@kharian.au.edu.pk</p>
                <p class="small text-white-50 m-0"><strong>Operating Hours:</strong> Mon - Fri | 08:30 AM - 04:30 PM</p>
            </div>
        </div>
        <hr class="my-5" style="border-color: rgba(255,255,255,0.08);" />
        <div class="text-center small text-white-50" style="letter-spacing: 0.5px;">
            &copy; 2026 AU Kharian Portal Administration. All Rights Reserved.
        </div>
    </div>
</footer>