@page "/"
@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    /* 100% Custom Style Enforcements matching your requirements */
    .hero-container {
        min-height: 75vh;
        /* Using a crisp fallback architecture placeholder until your physical campus photo is inside /wwwroot/ */
        background: linear-gradient(rgba(10, 25, 47, 0.75), rgba(10, 25, 47, 0.85)), url('/images/au-kharian-campus.jpg'), url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?q=80&w=1600');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .transparent-glass-card {
        background: rgba(255, 255, 255, 0.12) !important;
        backdrop-filter: blur(15px) !important;
        -webkit-backdrop-filter: blur(15px) !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        max-width: 700px;
        width: 100%;
    }

    .icon-badge {
        width: 60px;
        height: 60px;
        background-color: #e0f2fe;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
</style>

<div class="hero-container">
    <div class="transparent-glass-card p-4 p-md-5 rounded-4 text-center shadow-lg mx-3">
        <span class="badge bg-info text-dark mb-3 fw-bold px-3 py-2 text-uppercase">AU Kharian Campus Gateway</span>
        <h1 class="display-4 fw-bold text-white mb-3">Lost & Found Registry</h1>
        <p class="text-white-50 fs-5 mb-4">
            Welcome to the official automated portal for tracking, reporting, and reclaiming misplaced assets within the university premises.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="browse-items" class="btn btn-info px-4 py-2.5 fw-bold rounded-pill text-dark">
                <i class="bi bi-search me-1"></i>Browse Items
            </a>
            @if (!SessionState.IsLoggedIn)
            {
                <a href="login" class="btn btn-outline-light px-4 py-2.5 fw-bold rounded-pill">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In Access
                </a>
            }
        </div>
    </div>
</div>

<div id="how-it-works" class="py-5 bg-white">
    <div class="container py-3">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-dark">How The Portal Works</h2>
            <p class="text-muted">Simple 3-step asset retrieval lifecycle management</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="icon-badge text-primary">
                    <i class="bi bi-pencil-square fs-3"></i>
                </div>
                <h5 class="fw-bold">1. Submit a Case</h5>
                <p class="text-muted small px-3">Log missing properties or report items discovered on university grounds instantly.</p>
            </div>
            <div class="col-md-4">
                <div class="icon-badge text-info">
                    <i class="bi bi-shield-check fs-3"></i>
                </div>
                <h5 class="fw-bold">2. Search & Match</h5>
                <p class="text-muted small px-3">Browse indexed registries globally via live structural attribute filtering models.</p>
            </div>
            <div class="col-md-4">
                <div class="icon-badge text-success">
                    <i class="bi bi-hand-thumbs-up fs-3"></i>
                </div>
                <h5 class="fw-bold">3. Reclaim Property</h5>
                <p class="text-muted small px-3">Verify item ownership context securely at the campus safety desk for checkout sign-off.</p>
            </div>
        </div>
    </div>
</div>

<footer class="bg-dark text-light pt-5 pb-4 border-top border-secondary">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="text-info fw-bold mb-3"><i class="bi bi-building me-2"></i>Air University Kharian Campus</h5>
                <p class="small text-white-50 mb-2">
                    Official recovery portal designed to support administrative custody and student safety operations across corporate university sectors.
                </p>
                <p class="small text-white-50 m-0">
                    <i class="bi bi-geo-alt-fill text-info me-1"></i> GT Road, Kharian, Punjab, Pakistan
                </p>
            </div>
            <div class="col-md-6 text-md-end">
                <h5 class="text-info fw-bold mb-3"><i class="bi bi-telephone-fill me-2"></i>Security Desk Help</h5>
                <p class="small text-white-50 mb-1"><strong>Support Line:</strong> +92-53-111-282-111</p>
                <p class="small text-white-50 mb-1"><strong>Administrative Email:</strong> support@kharian.au.edu.pk</p>
                <p class="small text-white-50 m-0"><strong>Operating Hours:</strong> Mon - Fri | 08:30 AM - 04:30 PM</p>
            </div>
        </div>
        <hr class="border-secondary my-4" />
        <div class="text-center small text-white-50">
            &copy; 2026 AU Kharian Portal Administration. All Rights Reserved.
        </div>
    </div>
</footer>