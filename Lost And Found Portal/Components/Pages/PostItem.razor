@page "/report-case"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div>
    <h3>Report an Item Case</h3>

    @if (!SessionState.IsLoggedIn)
    {
        <p style="color: red; font-weight: bold;">Access Denied: You must be signed in to submit a report case.</p>
        <a href="login">Go to Login Page</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="color: green; font-weight: bold; margin-bottom: 15px;">@successMessage</div>
        }

        <EditForm Model="itemModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Item Title / Name:</label>
                <InputText @bind-Value="itemModel.Title" style="width: 100%; max-width: 400px; padding: 6px;" placeholder="e.g., Keys, Black Leather Wallet" />
                <div style="color: red; font-size: 0.85rem;"><ValidationMessage For="() => itemModel.Title" /></div>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Location Found / Lost:</label>
                <InputText @bind-Value="itemModel.Location" style="width: 100%; max-width: 400px; padding: 6px;" placeholder="e.g., Cafeteria, Block B Room 4" />
                <div style="color: red; font-size: 0.85rem;"><ValidationMessage For="() => itemModel.Location" /></div>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Report Type:</label>
                <InputSelect @bind-Value="isLostString" style="width: 100%; max-width: 400px; padding: 6px;">
                    <option value="True">I Lost This Item (Lost Item)</option>
                    <option value="False">I Found This Item (Found Item)</option>
                </InputSelect>
            </div>

            <button type="submit" style="padding: 8px 24px; background-color: #004071; color: white; border: none; font-weight: bold; cursor: pointer;">
                Submit Report
            </button>
        </EditForm>
    }
</div>

@code {
    private Item itemModel = new Item();
    private string isLostString = "True";
    private string? successMessage;

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task HandleValidSubmit()
    {
        // Bind settings from localized fields onto our submission object record
        itemModel.IsLost = bool.Parse(isLostString);
        itemModel.UserEmail = SessionState.CurrentUserEmail ?? "anonymous@au.edu.pk";
        itemModel.ClaimStatus = "Available";

        await ItemService.AddItemAsync(itemModel);
        successMessage = "Case reported successfully!";

        await Task.Delay(1500);
        Nav.NavigateTo("/dashboard");
    }
}