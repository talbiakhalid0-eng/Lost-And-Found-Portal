@page "/report-case"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Services
@using Lost_And_Found_Portal.Components.Data
@inject IItemService ItemService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5 pt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4">
        <h2 class="fw-bold text-navy">Submit a Report</h2>
        <EditForm Model="newItem" OnValidSubmit="HandleSubmit">
            <div class="mb-3">
                <label>Item Name</label>
                <InputText @bind-Value="newItem.Title" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Type</label>
                    <InputSelect @bind-Value="newItem.IsLost" class="form-select">
                        <option value="true">I Lost Something</option>
                        <option value="false">I Found Something</option>
                    </InputSelect>
                </div>
                <div class="col-md-6 mb-3">
                    <label>Location (at AU Kharian)</label>
                    <InputText @bind-Value="newItem.Location" class="form-control" placeholder="e.g. Admin Block" />
                </div>
            </div>

            <button type="submit" class="btn btn-info w-100 rounded-pill fw-bold">Post Report</button>
        </EditForm>
    </div>
</div>

@code {
    private Item newItem = new();

    private async Task HandleSubmit()
    {
        await ItemService.CreateItemAsync(newItem);
        Nav.NavigateTo("/dashboard");
    }
}
