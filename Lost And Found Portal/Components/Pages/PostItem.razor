@page "/report-case"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm p-4 rounded-4 bg-white border-0 mb-5" style="max-width: 600px; width: 100%;">
        <div class="border-bottom pb-2 mb-4">
            <h3 class="fw-bold text-dark"><i class="bi bi-file-earmark-plus-fill text-primary me-2"></i>Report Campus Case</h3>
            <p class="text-muted small mb-0">Broadcast details about lost or recovered property across the AU network.</p>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-success small rounded-3 py-2 text-center mb-3">
                <i class="bi bi-check-circle-fill me-2"></i> @statusMessage
            </div>
        }

        <EditForm Model="newItem" OnValidSubmit="HandleCaseSubmission">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary">Case Entry Type</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="caseType" id="typeLost" checked="@newItem.IsLost" @onclick="() => newItem.IsLost = true" />
                        <label class="form-check-label small fw-semibold text-danger" for="typeLost">
                            <i class="bi bi-exclamation-circle me-1"></i>Lost Report
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="caseType" id="typeFound" checked="@(!newItem.IsLost)" @onclick="() => newItem.IsLost = false" />
                        <label class="form-check-label small fw-semibold text-success" for="typeFound">
                            <i class="bi bi-check-circle me-1"></i>Found/Recovered
                        </label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary">Item Title / Name <span class="text-danger">*</span></label>
                <input type="text" @bind-value="newItem.Title" class="form-control rounded-3" placeholder="e.g., Black Leather Wallet, HP Laptop Charger" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary">Inventory Category</label>
                <select @bind="newItem.Category" class="form-select rounded-3">
                    <option value="Personal Items">Personal Items</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Documents">Documents/IDs</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary">Estimated Campus Location <span class="text-danger">*</span></label>
                <input type="text" @bind-value="newItem.Location" class="form-control rounded-3" placeholder="e.g., Central Library Basement, Faculty Block Cafeteria" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary">Reference Image URL</label>
                <input type="url" @bind-value="newItem.ImageUrl" class="form-control rounded-3" placeholder="https://example.com/item-photo.jpg (Optional)" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold text-secondary">Detailed Description <span class="text-danger">*</span></label>
                <textarea @bind="newItem.Description" class="form-control rounded-3" rows="4" placeholder="Provide distinct characteristics like color, brand name, condition, or items inside..." required></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill w-50 fw-bold" @onclick='() => Nav.NavigateTo("/dashboard")'>
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary rounded-pill w-50 fw-bold shadow-sm">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i>Publish Case
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Item newItem = new() 
    { 
        Title = "", 
        Description = "", 
        Location = "", 
        Category = "Personal Items", 
        ImageUrl = "",
        IsLost = true,
        ClaimStatus = "Available" // Default inventory tracking state
    };
    
    private string? statusMessage;

    protected override void OnInitialized()
    {
        // Route Guard Protection check
        if (!SessionState.IsLoggedIn)
        {
            Nav.NavigateTo("login");
        }
    }

    private async Task HandleCaseSubmission()
    {
        // Inject current user tracking metadata before pipeline insertion
        newItem.UserEmail = SessionState.CurrentUserEmail;

        // Save raw record directly into database backend
        await ItemService.AddItemAsync(newItem);

        statusMessage = "Your report case has been broadcasted successfully!";
        
        // Brief visual delay layout refresh before jumping to user panel
        await Task.Delay(1500);
        Nav.NavigateTo("/dashboard");
    }
}@page "/report-case"
