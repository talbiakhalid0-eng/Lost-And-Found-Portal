@page "/report-case"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div>
    <h3>Report an Item Case</h3>

    @if (!SessionState.IsLoggedIn)
    {
        <p style="color: red; font-weight: bold;">Access Denied: You must be signed in to submit a report case.</p>
        <a href="login">Go to Login Page</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="color: green; font-weight: bold; margin-bottom: 15px;">@successMessage</div>
        }

        <div style="max-width: 400px;">
            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Item Title / Name:</label>
                <input type="text" @bind="itemTitle" style="width: 100%; padding: 6px;" placeholder="e.g., Keys, Wallet" />
                @if (showErrors && string.IsNullOrWhiteSpace(itemTitle))
                {
                    <div style="color: red; font-size: 0.85rem;">Please provide an item title.</div>
                }
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Location Found / Lost:</label>
                <input type="text" @bind="itemLocation" style="width: 100%; padding: 6px;" placeholder="e.g., Cafeteria, Block B" />
                @if (showErrors && string.IsNullOrWhiteSpace(itemLocation))
                {
                    <div style="color: red; font-size: 0.85rem;">Please specify a campus location.</div>
                }
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Report Type:</label>
                <select @bind="isLostString" style="width: 100%; padding: 6px;">
                    <option value="True">I Lost This Item (Lost Item)</option>
                    <option value="False">I Found This Item (Found Item)</option>
                </select>
            </div>

            <button type="button" @onclick="ProcessSubmission" style="padding: 8px 24px; background-color: #004071; color: white; border: none; font-weight: bold; cursor: pointer;">
                Submit Report
            </button>
        </div>
    }
</div>

@code {
    private string itemTitle = "";
    private string itemLocation = "";
    private string isLostString = "True";
    private string? successMessage;
    private bool showErrors = false;

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task ProcessSubmission()
    {
        showErrors = false;

        // Clean internal validation check
        if (string.IsNullOrWhiteSpace(itemTitle) || string.IsNullOrWhiteSpace(itemLocation))
        {
            showErrors = true;
            return;
        }

        var itemModel = new Item
        {
            Title = itemTitle,
            Location = itemLocation,
            IsLost = bool.Parse(isLostString),
            UserEmail = SessionState.CurrentUserEmail ?? "anonymous@au.edu.pk",
            ClaimStatus = "Available"
        };

        await ItemService.AddItemAsync(itemModel);
        successMessage = "Case reported successfully!";

        await Task.Delay(1200);
        Nav.NavigateTo("/dashboard");
    }
}