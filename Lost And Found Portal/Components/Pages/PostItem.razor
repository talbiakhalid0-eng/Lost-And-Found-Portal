@page "/report-case"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div>
    <h3>Report an Item Case</h3>

    @if (!SessionState.IsLoggedIn)
    {
        <p style="color: red; font-weight: bold;">Access Denied: You must be signed in to submit a report case.</p>
        <a href="login">Go to Login Page</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div style="color: green; font-weight: bold; margin-bottom: 15px; padding: 10px; background-color: #e6f4ea; border-radius: 4px;">
                ✔ @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(debugErrorMessage))
        {
            <div style="color: red; font-weight: bold; margin-bottom: 15px; padding: 10px; background-color: #fce8e6; border-radius: 4px;">
                ⚠ @debugErrorMessage
            </div>
        }

        <div style="max-width: 400px;">
            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Item Title / Name:</label>
                <input type="text" @bind="itemTitle" style="width: 100%; padding: 6px;" placeholder="e.g., Keys, Wallet" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Description:</label>
                <textarea @bind="itemDescription" rows="3" style="width: 100%; padding: 6px; resize: vertical;" placeholder="Provide details like color, brand..."></textarea>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Category:</label>
                <select @bind="itemCategory" style="width: 100%; padding: 6px;">
                    <option value="Personal Items">Personal Items (Wallet, Bags)</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Documents">Documents/IDs</option>
                    <option value="Books/Stationery">Books & Stationery</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Location Found / Lost:</label>
                <input type="text" @bind="itemLocation" style="width: 100%; padding: 6px;" placeholder="e.g., Cafeteria, Block B" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Contact Info (Phone / WhatsApp):</label>
                <input type="text" @bind="itemContactInfo" style="width: 100%; padding: 6px;" placeholder="e.g., 0300-1234567" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Image Link / URL:</label>
                <input type="text" @bind="itemImageUrl" style="width: 100%; padding: 6px;" placeholder="e.g., /images/placeholder.png" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Report Type:</label>
                <select @bind="isLostString" style="width: 100%; padding: 6px;">
                    <option value="True">I Lost This Item (Lost Item)</option>
                    <option value="False">I Found This Item (Found Item)</option>
                </select>
            </div>

            <button type="button" @onclick="ProcessSubmission" disabled="@isProcessing" style="padding: 10px 24px; background-color: #004071; color: white; border: none; font-weight: bold; cursor: @(isProcessing ? "not-allowed" : "pointer"); width: 100%; opacity: @(isProcessing ? "0.6" : "1");">
                @(isProcessing ? "Processing Submission..." : "Submit Report")
            </button>
        </div>
    }
</div>

@code {
    private string itemTitle = "";
    private string itemDescription = "";
    private string itemCategory = "Personal Items";
    private string itemLocation = "";
    private string itemContactInfo = "";
    private string itemImageUrl = "";
    private string isLostString = "True";

    private string? successMessage;
    private string? debugErrorMessage;
    private bool isProcessing = false;

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task ProcessSubmission()
    {
        // Prevent accidental double clicks from stalling execution pipelines
        if (isProcessing) return;

        try
        {
            isProcessing = true;
            successMessage = null;
            debugErrorMessage = null;
            StateHasChanged(); // Force Blazor UI update to visually display the tracking click event

            // Fallback safety checks to ensure the form fields are never sent as blank text
            if (string.IsNullOrWhiteSpace(itemTitle)) itemTitle = "Untitled Item";
            if (string.IsNullOrWhiteSpace(itemLocation)) itemLocation = "Campus Grounds";
            if (string.IsNullOrWhiteSpace(itemContactInfo)) itemContactInfo = "Provided via Session Account";

            var itemModel = new Item
            {
                Title = itemTitle,
                Description = string.IsNullOrWhiteSpace(itemDescription) ? "No description provided." : itemDescription,
                Category = itemCategory,
                Location = itemLocation,
                ContactInfo = itemContactInfo,
                ImageUrl = string.IsNullOrWhiteSpace(itemImageUrl) ? "/images/placeholder.png" : itemImageUrl,
                IsLost = bool.Parse(isLostString),
                UserEmail = SessionState.CurrentUserEmail ?? "anonymous@au.edu.pk",
                ClaimStatus = "Available"
            };

            // Call database layer execution method
            await ItemService.AddItemAsync(itemModel);

            successMessage = "Case reported successfully! Redirecting...";
            StateHasChanged();

            await Task.Delay(1500);
            Nav.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            // Catches any underlying execution faults and explicitly surfaces them visually
            debugErrorMessage = $"Submission blocked: {ex.Message}";
            isProcessing = false;
            StateHasChanged();
        }
    }
}