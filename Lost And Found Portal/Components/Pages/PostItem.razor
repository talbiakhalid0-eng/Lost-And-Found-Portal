@page "/report-case"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto rounded-4" style="max-width: 600px; border: none;">
        <h2 class="fw-bold text-center text-primary mb-4">Report an Item Case</h2>

        @if (!SessionState.IsLoggedIn)
        {
            <div class="alert alert-warning text-center">
                <h5>Access Denied</h5>
                <p class="small">You must be signed in to submit a report case.</p>
                <a href="login" class="btn btn-sm btn-primary rounded-pill px-3">Go to Login</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success text-center">@successMessage</div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Item Title / Name</label>
                <input type="text" @bind="itemTitle" class="form-control" placeholder="e.g., Black Leather Wallet, Keys" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Location Found / Lost</label>
                <input type="text" @bind="itemLocation" class="form-control" placeholder="e.g., Cafeteria, Block B Room 4" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Report Type</label>
                <select @bind="isLostSelection" class="form-select">
                    <option value="True">I Lost This Item (Lost Item)</option>
                    <option value="False">I Found This Item (Found Item)</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Simulated Image Attachment Link</label>
                <input type="text" @bind="imageUrlInput" class="form-control" placeholder="Paste image address URL or leave empty" />
            </div>

            <button @onclick="SubmitItemCase" class="btn btn-success w-100 rounded-pill py-2 fw-bold shadow-sm">
                Submit Report
            </button>
        }
    </div>
</div>

@code {
    private string itemTitle = "";
    private string itemLocation = "";
    private string isLostSelection = "True";
    private string imageUrlInput = "";
    private string? successMessage;

    private async Task SubmitItemCase()
    {
        if (string.IsNullOrEmpty(itemTitle) || string.IsNullOrEmpty(itemLocation))
        {
            return;
        }

        var newItem = new Item
        {
            Title = itemTitle,
            Location = itemLocation,
            IsLost = bool.Parse(isLostSelection),
            ImageUrl = string.IsNullOrEmpty(imageUrlInput) ? "images/placeholder.png" : imageUrlInput,
            UserEmail = SessionState.CurrentUserEmail,
            IsApproved = true, // Auto-approve for development workflow testing
            ClaimStatus = "Available"
        };

        await ItemService.AddItemAsync(newItem);
        successMessage = "Case reported successfully!";

        // Brief pause to display success banner before navigating away
        await Task.Delay(1500);
        Nav.NavigateTo("/dashboard");
    }
}