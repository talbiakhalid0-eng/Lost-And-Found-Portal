@page "/dashboard"
@using Lost_And_Found_Portal.Services
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="container mt-5 pt-5">
    <div class="card p-5 shadow rounded-4 text-center">
        <h1 class="fw-bold text-success"><i class="bi bi-check-circle-fill"></i> Welcome to the Dashboard!</h1>
        <p class="text-muted mt-2">You have successfully authenticated into the AU Kharian Portal.</p>
        <div class="alert alert-info d-inline-block mx-auto px-4 py-2 mt-3 rounded-pill">
            Current User: <strong>@SessionState.CurrentUserEmail</strong>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
        }
    }
}