@page "/dashboard"
@page "/post-item"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Services
@using Lost_And_Found_Portal.Components.Data
@inject IItemService ItemService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5 pt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-navy">AU Kharian Active Reports</h2>
        <div class="search-box w-25">
            <input type="text" class="form-control rounded-pill"
                   placeholder="Search items..." @oninput="HandleSearch" />
        </div>
    </div>

    @if (filteredItems == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-info" role="status"></div>
            <p>Loading reports...</p>
        </div>
    }
    else if (!filteredItems.Any())
    {
        <div class="alert alert-light text-center border p-5 rounded-4">
            <i class="bi bi-search display-1 text-muted"></i>
            <p class="mt-3">No matching reports found for AU Kharian.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in filteredItems)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        @* Placeholder for Item Image *@
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                            <i class="bi bi-image text-muted display-4"></i>
                        </div>
                        <div class="card-body">
                            <span class="badge @(item.IsLost ? "bg-danger" : "bg-success") mb-2">
                                @(item.IsLost ? "Lost" : "Found")
                            </span>
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-info"></i> @item.Location
                            </p>
                            <button class="btn btn-outline-info w-100 rounded-pill btn-sm">View Details</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Item> allItems = new();
    private List<Item> filteredItems = new();

    protected override async Task OnInitializedAsync()
    {
        allItems = await ItemService.GetAllItemsAsync();
        filteredItems = allItems;
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        var searchTerm = e.Value?.ToString()?.ToLower() ?? "";
        filteredItems = allItems
            .Where(i => i.Title.ToLower().Contains(searchTerm) ||
                        i.Location.ToLower().Contains(searchTerm))
            .ToList();
    }
}