@page "/browse-items"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@rendermode RenderMode.InteractiveServer

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-7">
            <h2 class="fw-bold text-navy mb-1"><i class="bi bi-search text-info me-2"></i>Active Registry Feed</h2>
            <p class="text-muted small mb-0">Search and claim reported campus items across AU Kharian</p>
        </div>
        <div class="col-md-5 mt-3 mt-md-0">
            <div class="input-group shadow-sm rounded-pill overflow-hidden bg-white border px-2 py-1">
                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" @bind="searchQuery" @bind:event="oninput" class="form-control border-0 bg-transparent form-control-sm" placeholder="Search by name, location..." style="outline: none; box-shadow: none;" />
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-start gap-2 mb-4">
        <button class="btn btn-sm rounded-pill px-3 shadow-sm @(filterType == "All" ? "btn-dark" : "btn-outline-dark")" @onclick='() => filterType = "All"'>All Items</button>
        <button class="btn btn-sm rounded-pill px-3 shadow-sm @(filterType == "Lost" ? "btn-danger" : "btn-outline-danger")" @onclick='() => filterType = "Lost"'>Lost Cases</button>
        <button class="btn btn-sm rounded-pill px-3 shadow-sm @(filterType == "Found" ? "btn-success" : "btn-outline-success")" @onclick='() => filterType = "Found"'>Found Cases</button>
    </div>

    @if (filteredItems == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted small mt-2">Fetching live database registers...</p>
        </div>
    }
    else if (!filteredItems.Any())
    {
        <div class="text-center py-5 bg-white border border-dashed rounded-4 shadow-sm">
            <i class="bi bi-folder-x text-muted display-4"></i>
            <h5 class="fw-bold mt-2 text-dark">No Matching Items Found</h5>
            <p class="text-muted small mb-0 px-3">Try adjusting your terms or check back later for updates.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in filteredItems)
            {
                <div class="col">
                    <div class="card h-100 shadow border-0 rounded-4 overflow-hidden position-relative hover-lift">

                        <div class="position-absolute top-0 end-0 m-3 z-1">
                            <span class="badge rounded-pill px-3 py-2 fw-bold shadow-sm @(item.IsLost ? "bg-danger" : "bg-success")">
                                @(item.IsLost ? "LOST" : "FOUND")
                            </span>
                        </div>

                        <div class="bg-secondary-subtle d-flex align-items-center justify-content-center border-bottom text-muted position-relative" style="height: 180px;">
                            <i class="bi bi-box-seam display-5 opacity-50"></i>
                            <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-50 text-white py-1 px-3 small">
                                <i class="bi bi-geo-alt-fill text-info me-1"></i> @item.Location
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-1">@item.Title</h5>
                            <p class="text-muted small mb-3">Reporter: <span class="text-navy font-monospace">@item.UserEmail</span></p>

                            <div class="mt-auto pt-3 border-top">
                                @if (SessionState.IsLoggedIn)
                                {
                                    @if (item.UserEmail == SessionState.CurrentUserEmail)
                                    {
                                        <button class="btn btn-secondary w-100 rounded-pill btn-sm py-2" disabled>
                                            <i class="bi bi-person-fill me-1"></i> Your Report Case
                                        </button>
                                    }
                                    else if (item.ClaimStatus == "Claimed")
                                    {
                                        <div class="alert alert-warning text-center border-0 small py-2 mb-0 rounded-pill">
                                            <i class="bi bi-lock-fill me-1"></i> Claimed by: <strong>@item.ClaimedByEmail</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary w-100 rounded-pill btn-sm py-2 shadow-sm fw-bold" @onclick="() => InitiateClaimRequest(item)">
                                            <i class="bi bi-hand-index-thumb-fill me-1"></i> Claim This Item
                                        </button>
                                    }
                                }
                                else
                                {
                                    <a href="login" class="btn btn-outline-navy w-100 rounded-pill btn-sm py-2 text-center small fw-semibold">
                                        Sign In to Claim Case
                                    </a>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Item>? allItems;
    private string searchQuery = "";
    private string filterType = "All";

    protected override async Task OnInitializedAsync()
    {
        allItems = await ItemService.GetAllItemsAsync();
    }

    private IEnumerable<Item> filteredItems
    {
        get
        {
            if (allItems == null) return Enumerable.Empty<Item>();
            var results = allItems;

            if (!string.IsNullOrEmpty(searchQuery))
            {
                results = results.Where(i => i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                             i.Location.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (filterType == "Lost") results = results.Where(i => i.IsLost);
            if (filterType == "Found") results = results.Where(i => !i.IsLost);

            return results;
        }
    }

    private async Task InitiateClaimRequest(Item item)
    {
        item.ClaimedByEmail = SessionState.CurrentUserEmail;
        item.ClaimStatus = "Claimed";
        await ItemService.UpdateItemAsync(item);
        allItems = await ItemService.GetAllItemsAsync();
    }
}