@page "/browse-items"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="container mt-4">
    <div class="border-bottom pb-3 mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-search text-primary me-2"></i>Browse Items Registry</h2>
        <p class="text-muted small mb-0">Search and claim missing items across the AU Kharian campus network.</p>
    </div>

    <div class="row g-3 mb-4 p-3 bg-light rounded-3 shadow-sm border">
        <div class="col-md-5">
            <label class="form-label small fw-bold">Search Keywords</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" @bind-value="searchQuery" @bind-value:event="oninput" class="form-control" placeholder="Type name, description, or location..." />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold">Filter Category</label>
            <select @bind="selectedCategory" class="form-select">
                <option value="All">All Categories</option>
                <option value="Personal Items">Personal Items</option>
                <option value="Electronics">Electronics</option>
                <option value="Documents">Documents/IDs</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Case Status Type</label>
            <select @bind="selectedStatus" class="form-select">
                <option value="All">All Statuses</option>
                <option value="Lost">Lost Reports</option>
                <option value="Found">Found Reports</option>
            </select>
        </div>
    </div>

    @if (filteredItems == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted small mt-2">Loading campus item index registry...</p>
        </div>
    }
    else if (!filteredItems.Any())
    {
        <div class="alert alert-info text-center rounded-3 p-4">
            <i class="bi bi-info-circle-fill fs-4 d-block mb-2 text-primary"></i>
            <strong>No Items Found:</strong> Try changing your search keywords or filter dropdown settings.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in filteredItems)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                        <img src="@item.ImageUrl" class="card-img-top object-fit-cover" style="height: 180px;" onerror="this.src='/images/placeholder.png';" alt="Item Image" />
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold text-dark text-truncate mb-0" style="max-width: 75%;">@item.Title</h5>
                                <span class="badge rounded-pill px-2 py-1 @(item.IsLost ? "bg-danger text-white" : "bg-success text-white")">
                                    @(item.IsLost ? "Lost" : "Found")
                                </span>
                            </div>
                            <p class="text-muted small flex-grow-1 text-truncate" style="max-height: 50px;">@item.Description</p>

                            <div class="bg-light p-2 rounded-3 small border mb-3">
                                <div><i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>Location:</strong> @item.Location</div>
                                <div class="mt-1"><i class="bi bi-tag-fill text-primary me-1"></i><strong>Category:</strong> @item.Category</div>
                            </div>

                            @if (item.ClaimStatus == "Claimed")
                            {
                                <button class="btn btn-secondary btn-sm w-100 rounded-pill fw-bold" disabled>
                                    <i class="bi bi-check-circle-fill me-1"></i> Claimed / Resolved
                                </button>
                            }
                            else if (item.ClaimStatus == "PendingApproval")
                            {
                                <button class="btn btn-warning text-dark btn-sm w-100 rounded-pill fw-bold" disabled>
                                    <i class="bi bi-hourglass-split me-1"></i> Pending Security Approval
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm w-100 rounded-pill fw-bold mt-auto" @onclick="() => OpenClaimModal(item)">
                                    <i class="bi bi-hand-index-thumb me-1"></i> Claim Item
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (isModalOpen && selectedItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header bg-dark text-white rounded-top-4">
                    <h5 class="modal-title fw-bold"><i class="bi bi-shield-lock me-2"></i>Ownership Verification Form</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseClaimModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!SessionState.IsLoggedIn)
                    {
                        <div class="alert alert-danger rounded-3 small fw-bold text-center">
                            <i class="bi bi-shield-slash me-2"></i>Access Denied: You must be signed into your student account to claim items.
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-3">
                            You are requesting to claim <strong>@selectedItem.Title</strong>. Please supply unique identifying details (e.g. serial codes, specific contents, colors) to verify your claim.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Proof of Ownership Description <span class="text-danger">*</span></label>
                            <textarea @bind="proofText" class="form-control rounded-3" rows="4" placeholder="Describe unique identifying marks or details..." required></textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="text-danger small fw-bold mb-2">⚠ @modalError</div>
                        }
                        <button class="btn btn-success w-100 rounded-pill fw-bold py-2 shadow" @onclick="SubmitClaim">
                            <i class="bi bi-send-check-fill me-1"></i> Submit Claim to Admins
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Item>? allItems;
    private string searchQuery = "";
    private string selectedCategory = "All";
    private string selectedStatus = "All";

    private bool isModalOpen = false;
    private Item? selectedItem;
    private string proofText = "";
    private string? modalError;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        var fetched = await ItemService.GetAllItemsAsync();
        allItems = fetched.ToList();
    }

    // Live LINQ Query Multi-Filter Search Engine
    private IEnumerable<Item> filteredItems =>
        allItems?.Where(i =>
            (selectedCategory == "All" || i.Category == selectedCategory) &&
            (selectedStatus == "All" || (selectedStatus == "Lost" && i.IsLost) || (selectedStatus == "Found" && !i.IsLost)) &&
            (string.IsNullOrWhiteSpace(searchQuery) ||
             i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
             i.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
             i.Location.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ) ?? Enumerable.Empty<Item>();

    private void OpenClaimModal(Item item)
    {
        selectedItem = item;
        proofText = "";
        modalError = null;
        isModalOpen = true;
    }

    private void CloseClaimModal() => isModalOpen = false;

    private async Task SubmitClaim()
    {
        if (string.IsNullOrWhiteSpace(proofText))
        {
            modalError = "You must provide clear description text to verify ownership.";
            return;
        }

        if (selectedItem != null && SessionState.IsLoggedIn)
        {
            // Update item to a pending state and store verification logs
            selectedItem.ClaimStatus = "PendingApproval";
            selectedItem.ClaimedByEmail = SessionState.CurrentUserEmail;
            selectedItem.ClaimProofOfOwnership = proofText.Trim();

            await ItemService.UpdateItemAsync(selectedItem);

            isModalOpen = false;
            await LoadItems(); // Refresh the list
        }
    }
}