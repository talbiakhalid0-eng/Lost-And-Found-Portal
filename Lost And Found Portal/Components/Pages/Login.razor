@page "/login"
@using Lost_And_Found_Portal.Components.Models
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject Lost_And_Found_Portal.Services.IItemService AuthService

<div class="auth-wrapper">
    <div class="auth-card shadow-lg border-0 rounded-4 p-5">
        <div class="text-center mb-4">
            <img src="Images/Uploads/au-logo.png" style="height: 80px;" alt="AU Logo" />
            <h2 class="fw-bold mt-3 text-navy">Student Access</h2>
            <p class="text-muted">Enter your official university credentials</p>
        </div>

        @* Added FormName="loginForm" *@
        <EditForm Model="registerModel" OnValidSubmit="HandleRegistration" FormName="loginForm">
            <DataAnnotationsValidator />

            
            <InputText @bind-Value="registerModel.Email"
                       class="form-control border-start-0 ps-0"
                       placeholder="e.g. 247240@students.au.edu.pk" />

            <div class="mb-3">
                <label class="form-label fw-bold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-info"></i></span>
                    <InputText @bind-Value="registerModel.Password" type="password" class="form-control border-start-0 ps-0" />
                </div>
                <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small mt-1" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger small py-2 text-center">@errorMessage</div>
            }

            <button type="submit" class="btn btn-info w-100 rounded-pill fw-bold py-2 mt-3 shadow-sm">
                Sign In
            </button>

            <div class="text-center mt-3">
                <p class="small text-muted mb-0">
                    Don't have an account?
                    <a href="/register" class="text-info fw-bold text-decoration-none">Register here</a>
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterModel registerModel { get; set; } = new();

    private string? errorMessage;

    private async Task HandleRegistration()
    {
        // 1. Check if the user exists in the DB with this email and password
        var isValidUser = await AuthService.LoginUserAsync(registerModel.Email, registerModel.Password);

        if (isValidUser)
        {
            // 2. Success! Send them to the dashboard
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            // 3. Fail! Stay on page and show error
            errorMessage = "Invalid AU credentials. Please check your email or password.";
        }
    }
}