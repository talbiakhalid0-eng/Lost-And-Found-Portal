@page "/login"
@using Lost_And_Found_Portal.Components.Models
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject Lost_And_Found_Portal.Services.IItemService AuthService
@rendermode InteractiveServer

<div class="auth-wrapper">
    <div class="auth-card shadow-lg border-0 rounded-4 p-5">
        <div class="text-center mb-4">
            <img src="Images/Uploads/au-logo.png" style="height: 80px;" alt="AU Logo" />
            <h2 class="fw-bold mt-3 text-navy">Student Access</h2>
            <p class="text-muted">Enter your official university credentials</p>
        </div>

       <EditForm Model="registerModel" OnValidSubmit="HandleLogin" FormName="loginForm" @onsubmit:preventDefault>
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-bold">AU Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-info"></i></span>
                    <InputText @bind-Value="registerModel.Email"
                               class="form-control border-start-0 ps-0"
                               placeholder="e.g. 247240@students.au.edu.pk" />
                </div>
                <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small mt-1" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-info"></i></span>
                    <InputText @bind-Value="registerModel.Password" type="password" class="form-control border-start-0 ps-0" />
                </div>
                <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small mt-1" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger small py-2 text-center">@errorMessage</div>
            }

            <button type="submit" class="btn btn-info w-100 rounded-pill fw-bold py-2 mt-3 shadow-sm">
    Sign In
</button>

            <div class="text-center mt-3">
                <p class="small text-muted mb-0">
                    Don't have an account?
                    <a href="/register" class="text-info fw-bold text-decoration-none">Register here</a>
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterModel? registerModel { get; set; }

    private string? errorMessage;
    protected override void OnInitialized()
    {
        // Initialize here instead to satisfy the Blazor compiler
        registerModel ??= new();
    }

    private async Task HandleLogin()
    {
        // 1. Clear previous errors and show status
        errorMessage = "Verifying credentials...";
        StateHasChanged();

        try
        {
            var success = await AuthService.LoginUserAsync(registerModel.Email, registerModel.Password);

            if (success)
            {
                errorMessage = "Login successful! Redirecting...";
                StateHasChanged();

                // 2. Small delay ensures the UI updates before the redirect starts
                await Task.Delay(500);

                // 3. forceLoad: true is the "Magic Fix" for .NET 8 navigation hangs
                Nav.NavigateTo(Nav.BaseUri + "dashboard", forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid AU email or password.";
            }
        }
        catch (Exception ex)
        {
            // This helps you catch database connection issues (like SQLEXPRESS being asleep)
            errorMessage = $"Connection error: {ex.Message}";
        }
    }
}