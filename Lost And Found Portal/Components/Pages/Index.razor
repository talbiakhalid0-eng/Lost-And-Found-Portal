@page "/"

@* Section 1: Hero Section *@
<section class="hero-section">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">LOST & FOUND PORTAL</h1>
        <p class="lead fs-4 mb-4">The official University Campus Security system for tracking and returning lost items.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="post-item" class="btn btn-primary btn-lg px-5 rounded-pill">Report Lost Item</a>
            <button class="btn btn-outline-light btn-lg px-5 rounded-pill">Browse Items</button>
        </div>
    </div>
</section>

@* Section 2: How It Works *@
<section class="py-5 bg-white">
    <div class="container py-5 text-center">
        <h2 class="fw-bold mb-5">How It Works</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card p-4 shadow-sm h-100">
                    <i class="bi bi-megaphone text-primary display-4 mb-3"></i>
                    <h4>Report Item</h4>
                    <p class="text-muted">Fill out a simple form with details and a photo of the lost or found item.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card p-4 shadow-sm h-100">
                    <i class="bi bi-search text-primary display-4 mb-3"></i>
                    <h4>We Match</h4>
                    <p class="text-muted">Our system scans all reports to find potential matches automatically.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card p-4 shadow-sm h-100">
                    <i class="bi bi-hand-thumbs-up text-primary display-4 mb-3"></i>
                    <h4>Return</h4>
                    <p class="text-muted">Coordinate a safe pickup through the Campus Security office.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* Section 3: Footer *@
<footer>
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h5 class="fw-bold mb-3">University Security</h5>
                <p class="small text-secondary">Ensuring a safe and secure environment for our academic community 24/7.</p>
            </div>
            <div class="col-md-4 mb-4">
                <h5 class="fw-bold mb-3">Quick Links</h5>
                <ul class="list-unstyled small">
                    <li><a href="#" class="text-secondary text-decoration-none">Privacy Policy</a></li>
                    <li><a href="#" class="text-secondary text-decoration-none">Terms of Service</a></li>
                    <li><a href="#" class="text-secondary text-decoration-none">Contact Support</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-4">
                <h5 class="fw-bold mb-3">Location</h5>
                <p class="small text-secondary">Main Campus, Security Block A<br>Emergency: +1 (555) 000-1234</p>
            </div>
        </div>
        <hr class="border-secondary my-4">
        <p class="text-center small text-secondary">&copy; 2026 Certo University Security Management v1.0</p>
    </div>
</footer>