@page "/"

@* Hero Section *@
<div class="hero-wrap">
    <div class="container h-100 d-flex align-items-center justify-content-center text-center">
        <div class="hero-content p-5 rounded-4">
            <h1 class="display-3 fw-bold text-white shadow-sm">LOST & FOUND PORTAL</h1>
            <p class="lead text-white-50 mb-4">Official Security Portal for Air University Kharian Campus Students and Staff.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="report-case" class="btn btn-info btn-lg px-5 rounded-pill shadow">Report New Item</a>
                <a href="dashboard" class="btn btn-outline-light btn-lg px-5 rounded-pill">View All Items</a>
            </div>
        </div>
    </div>
</div>

@* How It Works Section *@
<section class="py-5 bg-white">
    <div class="container py-5">
        <h2 class="text-center fw-bold mb-5" style="color: #003366;">How the Portal Works</h2>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="p-4 bg-light shadow-sm rounded-4 h-100">
                    <i class="bi bi-clipboard-check text-primary display-4"></i>
                    <h4 class="mt-3">1. Report Item</h4>
                    <p class="text-muted">Fill out a simple form with item details and the location it was found or lost.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="p-4 bg-light shadow-sm rounded-4 h-100">
                    <i class="bi bi-search text-primary display-4"></i>
                    <h4 class="mt-3">2. System Match</h4>
                    <p class="text-muted">Our database cross-checks all reports to find potential matches instantly.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="p-4 bg-light shadow-sm rounded-4 h-100">
                    <i class="bi bi-shield-check text-primary display-4"></i>
                    <h4 class="mt-3">3. Secure Pickup</h4>
                    <p class="text-muted">Once verified, claim your item from the AU Kharian Security Office.</p>
                </div>
            </div>
        </div>
    </div>
</section>