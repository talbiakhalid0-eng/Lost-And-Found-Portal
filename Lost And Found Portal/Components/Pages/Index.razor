@page "/"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService



<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4 p-4 obsidian-card shadow">
        <div>
            <h1 class="display-5 text-white fw-bold mb-0">LOST & FOUND <span class="text-info">PORTAL</span></h1>
            <p class="text-secondary mb-0">University Campus Security System</p>
        </div>
        <a href="/post-item" class="btn btn-info btn-lg px-5 fw-bold">Report New Item</a>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-info"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control form-control-lg bg-dark text-white border-secondary"
                       placeholder="Search by title..." @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="p-3 border border-info rounded bg-dark text-center shadow-sm">
                <h6 class="text-secondary small mb-1">TOTAL REPORTS</h6>
                <h3 class="text-white fw-bold mb-0">@(allItems?.Count ?? 0)</h3>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3 overflow-auto pb-2">
        <button class="btn btn-info btn-sm px-4" @onclick='() => FilterByCategory("All")'>All</button>
        <button class="btn btn-outline-secondary btn-sm px-4" @onclick='() => FilterByCategory("Electronics")'>Electronics</button>
        <button class="btn btn-outline-secondary btn-sm px-4" @onclick='() => FilterByCategory("Personal")'>Personal</button>
    </div>

    <div class="row g-4">
        @if (filteredItems == null)
        {
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-info" role="status"></div>
                <p class="text-secondary mt-2">Loading items...</p>
            </div>
        }
        else if (!filteredItems.Any())
        {
            <div class="col-12 text-center py-5 obsidian-card mt-4">
                <i class="bi bi-clipboard-x display-1 text-secondary mb-3"></i>
                <h3 class="text-white">No Items Reported</h3>
                <p class="text-secondary">All clear! No lost or found items match your search.</p>
                <a href="/post-item" class="btn btn-info mt-2">Report an Item</a>
            </div>
        }
        else
        {
            @foreach (var item in filteredItems)
            {
                <div class="col-md-4">
                    <div class="obsidian-card p-4 h-100 border-start border-info border-4 shadow-lg"
                         style="background: #1d2127; position: relative; border-radius: 8px;">

                        <button class="btn btn-sm text-secondary p-0"
                                style="position: absolute; top: 10px; right: 15px; border: none; background: transparent;"
                                @onclick="() => DeleteItem(item.Id)"
                                title="Remove this report">
                            <i class="bi bi-trash3-fill text-danger"></i>
                        </button>

                        <span class="badge @(item.Status == "Lost" ? "bg-danger" : "bg-success") mb-3">@item.Status</span>
                        <h4 class="text-white fw-bold">@item.Title</h4>
                        <p class="text-info mb-1">Category: @item.Category</p>
                        <p class="text-secondary small">Posted on: @item.DatePosted.ToShortDateString()</p>

                        <button class="btn btn-outline-light btn-sm mt-2 w-100" @onclick="() => ToggleStatus(item)">
                            Mark as @(item.Status == "Lost" ? "Found" : "Lost")
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>
@code {
    private List<Item> allItems;
    private List<Item> filteredItems;
    private string SearchTerm { get; set; } = "";
    private string SelectedCategory { get; set; } = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        allItems = await ItemService.GetAllItemsAsync();
        HandleSearch();
    }

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            filteredItems = allItems;
        }
        else
        {
            filteredItems = allItems
                .Where(x => x.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task DeleteItem(int id)
    {
        var success = await ItemService.DeleteItemAsync(id);
        if (success)
        {
            await LoadData(); 
        }
    }

    private async Task ToggleStatus(Item item)
    {
        item.Status = (item.Status == "Lost") ? "Found" : "Lost";
        await ItemService.UpdateItemAsync(item);
        await LoadData(); 
    }

    private void FilterByCategory(string category)
    {
        SelectedCategory = category;

        if (category == "All")
        {
            filteredItems = allItems;
        }
        else
        {
            filteredItems = allItems.Where(x => x.Category == category).ToList();
        }
    }
}