@page "/"

@* 1. FULL SCREEN HERO SECTION *@
<div class="hero-wrap">
    <div class="container h-100 d-flex align-items-center justify-content-center text-center">
        <div class="hero-content p-5 rounded-4">
            <h1 class="display-3 fw-bold text-white shadow-sm">LOST & FOUND PORTAL</h1>
            <p class="lead text-white-50 mb-4">Official Security Portal for Air University Kharian Campus Students and Staff.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="report-case" class="btn btn-info btn-lg px-5 rounded-pill shadow">Report New Item</a>
                <a href="dashboard" class="btn btn-outline-light btn-lg px-5 rounded-pill">View All Items</a>
            </div>
        </div>
    </div>
</div>

@* 2. THE IMPROVED WHITE SECTION *@
<section class="how-it-works-section" style="padding-top: 120px; padding-bottom: 120px; background-color: white;">
    <div class="container text-center">
        <h2 class="display-4 fw-bold mb-5" style="color: #003366;">How the Portal Works</h2>

        <div class="row g-5">
            @* Card 1: Report *@
            <div class="col-md-4">
                <div class="p-5 border rounded-4 shadow-sm h-100 bg-white">
                    <i class="bi bi-megaphone text-info display-1 mb-4"></i>
                    <h3 class="fw-bold" style="color: #003366;">Report Item</h3>
                    <p class="lead text-muted">Fill out the official AU form to report a lost or found item.</p>
                </div>
            </div>

            @* Card 2: Match *@
            <div class="col-md-4">
                <div class="p-5 border rounded-4 shadow-sm h-100 bg-white">
                    <i class="bi bi-cpu text-info display-1 mb-4"></i>
                    <h3 class="fw-bold" style="color: #003366;">System Match</h3>
                    <p class="lead text-muted">Our database cross-checks all reports to find potential matches instantly.</p>
                </div>
            </div>

            @* Card 3: Return *@
            <div class="col-md-4">
                <div class="p-5 border rounded-4 shadow-sm h-100 bg-white">
                    <i class="bi bi-shield-check text-info display-1 mb-4"></i>
                    <h3 class="fw-bold" style="color: #003366;">Secure Pickup</h3>
                    <p class="lead text-muted">Once verified, claim your item from the AU Kharian Security Office.</p>
                </div>
            </div>
        </div>
    </div>
</section>