@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="border-bottom pb-3 mb-4" style="border-color: rgba(255,255,255,0.1) !important;">
        <h2 class="fw-bold text-danger"><i class="bi bi-shield-check-fill me-2"></i>Security Moderation Desk</h2>
        <p class="text-white-50 small mb-0">Evaluate verification logs, approve ownership claims, or purge entries.</p>
    </div>

    @if (masterItemsList == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-white-50 small mt-2">Streaming real-time database rows...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow rounded-4 overflow-hidden bg-dark border border-secondary border-opacity-25">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 text-white">
                    <thead class="table-secondary text-dark small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-3">Item Details</th>
                            <th>Status State</th>
                            <th>Claimed By Account</th>
                            <th>Submitted Ownership Proof</th>
                            <th class="text-center">Moderator Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var item in masterItemsList)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-info">@item.Title</div>
                                    <div class="text-white-50 xsmall"><i class="bi bi-geo-alt"></i> @item.Location | @item.Category</div>
                                </td>
                                <td>
                                    <span class="badge px-2 py-1 rounded-pill @(item.ClaimStatus == "Claimed" ? "bg-success text-white" : item.ClaimStatus == "PendingApproval" ? "bg-warning text-dark fw-bold" : "bg-secondary text-light border border-opacity-25")">
                                        @item.ClaimStatus
                                    </span>
                                </td>
                                <td>
                                    <span class="font-monospace text-info fw-semibold">@(item.ClaimedByEmail ?? "None / Available")</span>
                                </td>
                                <td style="max-width: 260px;" class="text-wrap">
                                    @if (!string.IsNullOrEmpty(item.ClaimProofOfOwnership))
                                    {
                                        <div class="p-2 rounded bg-black bg-opacity-30 border border-secondary border-opacity-25 font-monospace text-white-50 xsmall">
                                            "@item.ClaimProofOfOwnership"
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic small">No claim filed yet</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="d-flex gap-2 justify-content-center">
                                        @if (item.ClaimStatus == "PendingApproval")
                                        {
                                            <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold" @onclick="() => HandleClaimResolution(item, true)">
                                                <i class="bi bi-check-circle-fill me-1"></i> Approve
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" @onclick="() => HandleClaimResolution(item, false)">
                                                <i class="bi bi-x-circle-fill me-1"></i> Reject
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-danger rounded-pill px-2 shadow-sm" title="Delete record permanently" @onclick="() => PurgeRecord(item.Id)">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Item>? masterItemsList;

    // 🚀 THE CRITICAL FIX: Safe async state lookup running safely after browser load
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.LoadSessionFromBrowserAsync();

            if (!IsUserAdmin())
            {
                Nav.NavigateTo("/dashboard");
                return;
            }

            await RefreshGrid();
            StateHasChanged();
        }
    }

    private bool IsUserAdmin()
    {
        if (string.IsNullOrEmpty(SessionState.CurrentUserEmail)) return false;

        var email = SessionState.CurrentUserEmail.ToLower().Trim();
        return email.Contains("admin") ||
               email == "247220@students.au.edu.pk" ||
               email.StartsWith("247240");
    }

    private async Task RefreshGrid()
    {
        var items = await ItemService.GetAllItemsAsync();
        masterItemsList = items.OrderByDescending(i => i.Id).ToList();
    }

    private async Task HandleClaimResolution(Item item, bool isApproved)
    {
        if (isApproved)
        {
            item.ClaimStatus = "Claimed";
        }
        else
        {
            item.ClaimStatus = "Available";
            item.ClaimedByEmail = null;
            item.ClaimProofOfOwnership = null;
        }

        await ItemService.UpdateItemAsync(item);
        await RefreshGrid();
    }

    private async Task PurgeRecord(int itemId)
    {
        await ItemService.DeleteItemAsync(itemId);
        await RefreshGrid();
    }
}