@page "/admin/moderation"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="container mt-4">
    <div class="border-bottom pb-3 mb-4">
        <h2 class="fw-bold text-danger"><i class="bi bi-shield-lock-fill me-2"></i>Admin Moderation Panel</h2>
        <p class="text-muted small mb-0">Live entry resolution and database management console</p>
    </div>

    @if (masterItemsList == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted small mt-2">Streaming master active registry feed...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark small text-uppercase">
                        <tr>
                            <th class="ps-3">Item Name</th>
                            <th>Location</th>
                            <th>Reporter Contact Email</th>
                            <th>Claim Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var item in masterItemsList)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <span class="badge bg-light text-secondary border small text-uppercase" style="font-size: 10px;">@item.Category</span>
                                </td>
                                <td><i class="bi bi-geo-alt-fill text-info me-1"></i>@item.Location</td>
                                <td><span class="font-monospace text-navy">@item.UserEmail</span></td>
                                <td>
                                    <span class="badge px-2 py-1 rounded-pill @(item.ClaimStatus == "Claimed" ? "bg-warning text-dark fw-bold" : "bg-light text-muted border")">
                                        @item.ClaimStatus
                                    </span>
                                </td>
                                <td class="text-center pe-3">
                                    <button class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm fw-bold" @onclick="() => ProcessForcedPurge(item.Id)">
                                        <i class="bi bi-shield-x me-1"></i>Force Purge
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Item>? masterItemsList;

    protected override async Task OnInitializedAsync()
    {
        // HARD LOCKDOWN: Prevent background data exposure by bouncing unauthorized routing attempts
        if (!IsUserAdmin())
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        await RefreshGrid();
    }

    private bool IsUserAdmin()
    {
        if (string.IsNullOrEmpty(SessionState.CurrentUserEmail)) return false;
        return SessionState.CurrentUserEmail.Contains("admin") ||
               SessionState.CurrentUserEmail.StartsWith("247240"); // Explicit authorization elevation rule
    }

    private async Task RefreshGrid()
    {
        var items = await ItemService.GetAllItemsAsync();
        masterItemsList = items.OrderByDescending(i => i.Id).ToList();
    }

    private async Task ProcessForcedPurge(int itemId)
    {
        await ItemService.DeleteItemAsync(itemId);
        await RefreshGrid();
    }
}