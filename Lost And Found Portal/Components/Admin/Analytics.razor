@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="border-bottom pb-3 mb-4" style="border-color: rgba(255,255,255,0.1) !important;">
        <h2 class="fw-bold text-white"><i class="bi bi-graph-up-arrow text-info me-2"></i>System Analytics Engine</h2>
        <p class="text-white-50 small mb-0">Platform performance audit logs for AU Kharian Security Network</p>
    </div>

    @if (allSystemItems == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status"></div>
            <p class="text-white-50 small mt-2">Computing live operational parameters...</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-primary text-white p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Total Registers</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count</div>
                    <div class="small opacity-50 text-truncate">Cumulative database records</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-danger text-white p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Active Lost Cases</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count(i => i.IsLost)</div>
                    <div class="small opacity-50 text-truncate">Items reported missing</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-success text-white p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Active Found Cases</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count(i => !i.IsLost)</div>
                    <div class="small opacity-50 text-truncate">Items secured by finders</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-info text-dark p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Successful Claims</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count(i => i.ClaimStatus == "Claimed")</div>
                    <div class="small opacity-75 text-truncate">Matched & recovered items</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4 border border-secondary border-opacity-25" style="background: linear-gradient(145deg, #1e293b, #0f172a);">
            <h5 class="fw-bold text-white mb-3"><i class="bi bi-clock-history me-2"></i>Global Distribution Categories</h5>
            <div class="row text-center bg-black bg-opacity-20 rounded-3 py-3 g-2">
                <div class="col-4">
                    <div class="text-white-50 small fw-semibold">Electronics</div>
                    <div class="fs-4 fw-bold text-info">@allSystemItems.Count(i => i.Category == "Electronics")</div>
                </div>
                <div class="col-4">
                    <div class="text-white-50 small fw-semibold">Personal Items</div>
                    <div class="fs-4 fw-bold text-info">@allSystemItems.Count(i => i.Category == "Personal Items")</div>
                </div>
                <div class="col-4">
                    <div class="text-white-50 small fw-semibold">Other Groups</div>
                    <div class="fs-4 fw-bold text-info">@allSystemItems.Count(i => i.Category != "Electronics" && i.Category != "Personal Items")</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Item>? allSystemItems;

    // 🚀 THE CRITICAL FIX: Load from storage during AfterRender lifecycle to prevent redirection loop failures
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.LoadSessionFromBrowserAsync();

            if (!IsUserAdmin())
            {
                Nav.NavigateTo("/dashboard");
                return;
            }

            var items = await ItemService.GetAllItemsAsync();
            allSystemItems = items.ToList();
            StateHasChanged();
        }
    }

    private bool IsUserAdmin()
    {
        if (string.IsNullOrEmpty(SessionState.CurrentUserEmail)) return false;

        var email = SessionState.CurrentUserEmail.ToLower().Trim();
        return email.Contains("admin") ||
               email == "247220@students.au.edu.pk" ||
               email.StartsWith("247240");
    }
}