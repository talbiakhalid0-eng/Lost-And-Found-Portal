@page "/admin/analytics"
@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@inject NavigationManager Nav
@rendermode RenderMode.InteractiveServer

<div class="container mt-4">
    <div class="border-bottom pb-3 mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-graph-up-arrow text-primary me-2"></i>System Analytics Engine</h2>
        <p class="text-muted small mb-0">Platform performance audit logs for AU Kharian Security Network</p>
    </div>

    @if (allSystemItems == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted small mt-2">Computing live operational parameters...</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-primary text-white p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Total Registers</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count</div>
                    <div class="small opacity-50 text-truncate">Cumulative database records</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-danger text-white p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Active Lost Cases</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count(i => i.IsLost)</div>
                    <div class="small opacity-50 text-truncate">Items reported missing</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-success text-white p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Active Found Cases</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count(i => !i.IsLost)</div>
                    <div class="small opacity-50 text-truncate">Items secured by finders</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0 bg-warning text-dark p-3 rounded-4">
                    <div class="small text-uppercase opacity-75 fw-bold">Successful Claims</div>
                    <div class="display-5 fw-bold my-1">@allSystemItems.Count(i => i.ClaimStatus == "Claimed")</div>
                    <div class="small opacity-75 text-truncate">Matched & recovered items</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-2"></i>Global Distribution Categories</h5>
            <div class="row text-center bg-light rounded-3 py-3 g-2">
                <div class="col-4">
                    <div class="text-secondary small fw-semibold">Electronics</div>
                    <div class="fs-4 fw-bold text-dark">@allSystemItems.Count(i => i.Category == "Electronics")</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary small fw-semibold">Personal Items</div>
                    <div class="fs-4 fw-bold text-dark">@allSystemItems.Count(i => i.Category == "Personal Items")</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary small fw-semibold">Other Groups</div>
                    <div class="fs-4 fw-bold text-dark">@allSystemItems.Count(i => i.Category != "Electronics" && i.Category != "Personal Items")</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Item>? allSystemItems;

    protected override async Task OnInitializedAsync()
    {
        // HARD LOCKDOWN: Kick unauthenticated users or normal students back to the dashboard immediately
        if (!IsUserAdmin())
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        var items = await ItemService.GetAllItemsAsync();
        allSystemItems = items.ToList();
    }

    private bool IsUserAdmin()
    {
        if (string.IsNullOrEmpty(SessionState.CurrentUserEmail)) return false;
        return SessionState.CurrentUserEmail.Contains("admin") ||
               SessionState.CurrentUserEmail.StartsWith("247240"); // Admin access granted to your specific student profile
    }
}