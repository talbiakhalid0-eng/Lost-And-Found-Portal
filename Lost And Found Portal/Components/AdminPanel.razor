@using Lost_And_Found_Portal.Components.Models
@using Lost_And_Found_Portal.Components.Services
@using Lost_And_Found_Portal.Services
@inject IItemService ItemService
@inject UserSessionState SessionState
@rendermode RenderMode.InteractiveServer

<div class="container py-3">
    @if (!isLoaded)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <p class="text-muted small">Synchronizing administrative database layers...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-graph-up-arrow text-primary me-2"></i>System Performance Metrics</h4>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 border-start border-primary border-4">
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 11px;">Total Records</div>
                        <div class="fs-3 fw-bold text-dark">@allItems.Count</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 border-start border-danger border-4">
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 11px;">Lost Items</div>
                        <div class="fs-3 fw-bold text-danger">@allItems.Count(i => i.IsLost)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 border-start border-success border-4">
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 11px;">Found Items</div>
                        <div class="fs-3 fw-bold text-success">@allItems.Count(i => !i.IsLost)</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded-3 border-start border-warning border-4">
                        <div class="small text-muted text-uppercase fw-semibold" style="font-size: 11px;">Handed Over</div>
                        <div class="fs-3 fw-bold text-warning">@allItems.Count(i => i.ClaimStatus == "Claimed")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="p-4 bg-light border-bottom">
                <h4 class="fw-bold text-dark mb-1"><i class="bi bi-shield-check-fill text-danger me-2"></i>Security Moderation Desk</h4>
                <p class="text-muted small mb-0">Approve pending ownership matches or purge entries securely.</p>
            </div>

            <div class="table-responsive">
                <table class="table table-light table-striped table-hover align-middle mb-0 text-dark">
                    <thead class="table-dark small text-uppercase" style="font-size: 11px;">
                        <tr>
                            <th class="ps-4 py-3 text-white bg-dark">Item Profile</th>
                            <th class="py-3 text-white bg-dark">Status State</th>
                            <th class="py-3 text-white bg-dark">Claimant Identity</th>
                            <th class="py-3 text-white bg-dark">Submitted Ownership Proof</th>
                            <th class="text-center pe-4 py-3 text-white bg-dark">Resolution Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!allItems.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-dark fw-medium bg-white">
                                    No campus inventory entries logged in system database.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in allItems)
                            {
                                <tr>
                                    <td class="ps-4 bg-white text-dark">
                                        <div class="fw-bold mb-0 fs-6" style="color: #000000 !important;">@item.Title</div>
                                        <div style="font-size: 12px; margin-top: 2px; color: #333333 !important; font-weight: 600;">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.Location
                                            <span class="mx-1 text-muted">|</span>
                                            <i class="bi bi-tag-fill text-primary me-1"></i> @item.Category
                                        </div>
                                    </td>

                                    <td class="bg-white text-dark">
                                        <span class="badge px-2.5 py-1.5 rounded-pill shadow-sm text-uppercase fw-bold @GetStatusBadgeClass(item.ClaimStatus)" style="font-size: 10.5px;">
                                            @(string.IsNullOrWhiteSpace(item.ClaimStatus) ? "Available" : item.ClaimStatus)
                                        </span>
                                    </td>

                                    <td class="bg-white text-dark">
                                        @if (string.IsNullOrEmpty(item.ClaimedByEmail))
                                        {
                                            <span class="fw-bold small" style="color: #555555 !important;">None / Available</span>
                                        }
                                        else
                                        {
                                            <a href="mailto:@item.ClaimedByEmail" class="font-monospace fw-bold text-decoration-none px-2 py-1 rounded border" style="color: #0d6efd !important; background-color: #f8f9fa !important; font-size: 12px; display: inline-block;">
                                                @item.ClaimedByEmail
                                            </a>
                                        }
                                    </td>

                                    <td style="max-width: 250px;" class="text-wrap bg-white text-dark">
                                        @if (!string.IsNullOrEmpty(item.ClaimProofOfOwnership))
                                        {
                                            <div class="p-2.5 rounded border font-monospace fw-bold shadow-sm" style="font-size: 12px; line-height: 1.4; background-color: #f1f3f5 !important; border-color: #ced4da !important; color: #111111 !important;">
                                                <i class="bi bi-quote me-1 text-secondary"></i>@item.ClaimProofOfOwnership"
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="fst-italic font-monospace" style="color: #555555 !important; font-size: 11px; font-weight: 600;">No active claim filed</span>
                                        }
                                    </td>

                                    <td class="text-center pe-4 bg-white text-dark">
                                        <div class="d-flex gap-2 justify-content-center">
                                            @if (item.ClaimStatus == "PendingApproval")
                                            {
                                                <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" @onclick="() => HandleClaim(item, true)">
                                                    <i class="bi bi-check-lg me-1"></i>Approve
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold" @onclick="() => HandleClaim(item, false)">
                                                    <i class="bi bi-x-lg me-1"></i>Reject
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px;" title="Delete record permanently" @onclick="() => DeleteRecord(item.Id)">
                                                <i class="bi bi-trash3-fill fs-6"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            </div>
    }
</div>

@code {
    private List<Item> allItems = new();
    private bool isLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshData();
            isLoaded = true;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        var items = await ItemService.GetAllItemsAsync();
        allItems = items.OrderByDescending(i => i.Id).ToList();
    }

    private async Task HandleClaim(Item item, bool approve)
    {
        if (approve)
        {
            item.ClaimStatus = "Claimed";
        }
        else
        {
            item.ClaimStatus = "Available";
            item.ClaimedByEmail = null;
            item.ClaimProofOfOwnership = null;
        }
        await ItemService.UpdateItemAsync(item);
        await RefreshData();
    }

    private async Task DeleteRecord(int id)
    {
        await ItemService.DeleteItemAsync(id);
        await RefreshData();
    }

    private string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Claimed" => "bg-success text-white",
            "PendingApproval" => "bg-warning text-dark fw-bold",
            "Rejected" => "bg-danger text-white",
            "Available" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }
}